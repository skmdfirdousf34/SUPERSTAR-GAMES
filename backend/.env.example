# ==============================================================
# REAL PRODUCTION ENVIRONMENT CONFIGURATION FOR BETTING APP
# ==============================================================

# Server Network Config
PORT=5001
CORS_ORIGIN="http://localhost:3000"
# In Production: CORS_ORIGIN="https://yourdomain.com"

# Cryptographic JWT Token Secret (Generate a strong 64-char key)
JWT_SECRET="super_secret_betting_jwt_key_2026_daman_secure"

# Database URL (Supabase PostgreSQL Connection Strings)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ==============================================================
# REAL PAYOUT GATEWAY CONFIGURATION
# Options: "SANDBOX" | "CASHFREE" | "DECENTRO"
# ==============================================================
PAYOUT_PROVIDER="SANDBOX"

# Cashfree Payouts API (Instant IMPS / UPI 24x7)
# Get credentials from: https://merchant.cashfree.com/merchants/login
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="TEST" # Switch to "PRODUCTION" when live

# Decentro BaaS API (Optional alternate payout rail)
# Get credentials from: https://admin.decentro.tech/
DECENTRO_CLIENT_ID=""
DECENTRO_CLIENT_SECRET=""
DECENTRO_MODULE_SECRET=""
DECENTRO_PROVIDER_SECRET=""

# ==============================================================
# REAL RECHARGE (PayIN) MERCHANT UPI CONFIGURATION
# ==============================================================
# Your real business Current Account UPI VPA handle:
PAYMENT_UPI_ID="superstarpay@okhdfcbank"
PAYMENT_MERCHANT_NAME="SuperstarClub"
